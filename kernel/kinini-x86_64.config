# KiniNi kernel fragment (x86_64) - applied over allnoconfig via
# KCONFIG_ALLCONFIG. Pure vanilla LTS (6.12.x), no patches, tuned for
# the distro: sched_ext (BPF CPU schedulers) enabled like CachyOS,
# BTF for the scx userspace, and every driver the installed system
# needs in QEMU and on common hardware built in (=y), so the boot
# initramfs needs no kernel modules at all.
#
# CI applies: make KCONFIG_ALLCONFIG=kernel/kinini-x86_64.config allnoconfig
# and then asserts the critical options before building bzImage.

# ---------------------------------------------------------------- base
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_PREEMPT=y
CONFIG_HZ_1000=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_LOCALVERSION="-kinini"
CONFIG_DEFAULT_HOSTNAME="kinini"
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_TIMERS=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_DEFAULT_ON=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_DEBUG_KERNEL=y
CONFIG_SCHED_CLASS_EXT=y
CONFIG_SWAP=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_KALLSYMS=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_EARLY_PRINTK=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_PROC_SYSCTL=y
CONFIG_KEYS=y

# ---------------------------------------------------------------- BTF
# required by the sched_ext schedulers (libbpf reads /sys/kernel/btf)
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_BTF=y

# ------------------------------------------------------- bpf / tracing
# the scx schedulers ship fentry/fexit and tp_btf programs (plus kprobe
# fallbacks for futex tracking). on an allnoconfig base the whole ftrace
# machinery is off, so libbpf fails to load the BPF skeleton with
# -EINVAL ("Ftrace is not enabled in the kernel"); these options are
# what turns the trampoline/tracepoint side of BPF on
CONFIG_PERF_EVENTS=y
CONFIG_TRACEPOINTS=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_BPF_EVENTS=y
CONFIG_BPF_TRAMPOLINE=y

# -------------------------------------------------------------- buses
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCI_MMCONFIG=y
CONFIG_ACPI=y
CONFIG_X86_VERBOSE_BOOTUP=y
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_DMI=y
CONFIG_DMIID=y
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT=y

# -------------------------------------------------------------- block
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
# IO schedulers referenced by 66-kinini-iosched.rules
CONFIG_IOSCHED_BFQ=y
CONFIG_MQ_IOSCHED_DEADLINE=y
CONFIG_MQ_IOSCHED_KYBER=y

# ------------------------------------------------------------- storage
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_GENERIC=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_BLK=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y

# ----------------------------------------------------------------- net
CONFIG_NET=y
CONFIG_INET=y
# desktop distro: IPv6 stack (Void ships it too; dhcpcd uses it for RA)
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_SYN_COOKIES=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_VIRTIO_NET=y

# -------------------------------------------------------------- crypto
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_X86_64=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_SIMD=y
CONFIG_CRYPTO_CRYPTD=y
CONFIG_CRYPTO_GF128MUL=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_CRYPTO_USER_API=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_HASH=y

# ---------------------------------------------------------------- uefi
# EFI stub: grub boots the kernel via the EFI handover protocol, the
# kernel gets the EFI System Table and finds the ACPI tables through it
# (OVMF does not expose the RSDP in the legacy scan area). without this
# the UEFI boot has no ACPI: no MADT (no IO-APIC -> no PCI interrupts,
# NIC stays dead) and no S5 (poweroff halts instead).
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y

# ------------------------------------------------------------ tty/input
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VT=y
CONFIG_VGA_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_SERIO_LIBPS2=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_CMOS=y
CONFIG_HW_RANDOM=y

# ----------------------------------------------------------------- usb
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_HID=y

# ------------------------------------------------------------ filesystems
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
# debugfs: scx schedulers (scx_lavd & co.) require it for their
# frequency/idle stats - without it they abort at startup
CONFIG_DEBUG_FS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ASCII=y
# vfat default iocharset (ESP mounts) and utf8 fallback
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y

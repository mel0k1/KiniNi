#!/bin/sh
# kiwi-install - install KiniNi from the live system to a disk
#
# usage: kiwi-install [-D /dev/sdX] [-b bios|uefi] [-s SWAPMB] [-e] [-p FILE]
#                     [-d xfce|labwc|none] [-u USER] [-P FILE] [-A sudo|doas]
#                     [-z ZONE] [-l LOCALE] [-S SCHED] [-N] [-y] [-h]
#
#   -D DISK    target disk, e.g. /dev/sda (interactive picker if omitted;
#              since 0.5 the desktop flag is -d, the disk is -D)
#   -d DESKTOP graphical session to enable on the installed system:
#                xfce   Xfce 4.20 with the LightDM graphical login
#                labwc  minimal Wayland session (login on a console,
#                       then run 'kinini-labwc'; seatd + dbus enabled)
#                none   console only (the packages stay installed;
#                       enable a session later with svctl)
#              default: same desktop as the running live session
#   -u USER    create this regular user (in wheel/video/audio/input);
#              asked interactively when omitted (default 'kiwi')
#   -P FILE    file with USER's login password (first line; for scripted
#              installs, -u with -y requires it)
#   -A TOOL    privilege tool for the wheel group: sudo (default), doas
#              or both (needs the user of -u/-A; live uses sudo+NOPASSWD
#              for 'kiwi', which the installer removes from the target)
#   -b MODE    partition layout and bootloader:
#                bios  msdos label + offline extlinux (syslinux mbr)
#                uefi  gpt label + 512 MiB ESP with the standalone grub
#                      x86_64-efi binary at \EFI\BOOT\BOOTX64.EFI (the
#                      removable-drive fallback path: boots everywhere,
#                      no NVRAM entries required)
#              default: autodetect (uefi when booted with efivars)
#   -s SWAPMB  swap partition size in MiB (default: min(2*RAM, 4096);
#              0 disables the swap partition). zram swap is configured
#              regardless (see /etc/kinini/zram.conf)
#   -e         encrypt the root filesystem with LUKS2 (passphrase asked
#              twice interactively, or use -p). unlocked in the initramfs
#              at boot. the swap partition (if any) is encrypted with an
#              ephemeral random key via /etc/crypttab
#   -p FILE    file with the LUKS passphrase (implies -e; useful for
#              scripted installs)
#   -z ZONE    timezone, e.g. Europe/Moscow (interactive picker if
#              omitted; written to /etc/localtime)
#   -l LOCALE  system locale, e.g. ru_RU.UTF-8 (interactive picker if
#              omitted; /etc/locale.conf + generated with glibc-locales)
#   -S SCHED   enable the sched_ext CPU scheduler service (CachyOS-style
#              BPF schedulers from the 'scx' package: scx_lavd,
#              scx_bpfland, scx_flash, ...); "none" disables. interactive
#              picker if omitted; default in -y mode: scx_lavd
#   -N         do not enable the DHCP client (dhcpcd) service
#   -y         no questions: autodetected bootloader mode, default root
#              password ("kinini"), DHCP on, swap as given, UTC timezone,
#              en_US.UTF-8 locale, no LUKS (needs -p when combined with
#              -e), scx_lavd scheduler when available, live desktop, no
#              user (pass -u/-P to create one)
#
# the installer copies the running live system to a fresh ext4 partition,
# un-applies live-only tweaks (autologin, NOPASSWD sudo, live services),
# enables the chosen desktop services and the regular user, writes
# /etc/fstab (and /etc/crypttab for LUKS installs) and installs an
# offline bootloader shipped inside the ISO. everything runs from the
# live image, no network is needed.
# requires: sfdisk, mkfs.ext4, blkid, tar, dd; bios: extlinux + syslinux
# mbr/ldlinux; uefi: mkfs.vfat + /usr/lib/kinini/BOOTX64.EFI; luks:
# cryptsetup (in the live image and inside initramfs-disk.img).
set -eu

TARGET=/mnt/kinini
DEFROOTPW=kinini
ESP_MIB=512
LUKSNAME=kinini

die() {
        echo "kiwi-install: $*" >&2
        exit 1
}

have() {
        command -v "$1" >/dev/null 2>&1
}

msg() {
        echo "kiwi-install: $*"
}

ask() {
        # ask "question" default(y|n)
        a=$2
        printf '%s [%s] ' "$1" "$a"
        read -r ans
        [ -n "$ans" ] || ans=$a
        case "$ans" in
        [Yy]*)  return 0 ;;
        *)      return 1 ;;
        esac
}

usage() {
        echo "usage: kiwi-install [-D /dev/sdX] [-b bios|uefi] [-s SWAPMB] [-e] [-p FILE]" >&2
        echo "                    [-d xfce|labwc|none] [-u USER] [-P FILE] [-A sudo|doas]" >&2
        echo "                    [-z ZONE] [-l LOCALE] [-S SCHED] [-N] [-y] [-h]" >&2
        exit 1
}

DISK=
DESKTOP=
INSTUSER=
USERPASSFILE=
USERPASS=
ADMIN=sudo
YES=0
NODHCP=0
MODE=
SWAP=
LUKS=0
PASSFILE=
TMPKEY=0
ZONE=
LOCALE=
SCHED=
while getopts D:d:b:s:z:l:S:p:u:P:A:eNyh c; do
        case $c in
        D)      DISK=$OPTARG ;;
        d)      DESKTOP=$OPTARG ;;
        b)      MODE=$OPTARG ;;
        s)      SWAP=$OPTARG ;;
        z)      ZONE=$OPTARG ;;
        l)      LOCALE=$OPTARG ;;
        S)      SCHED=$OPTARG ;;
        p)      PASSFILE=$OPTARG LUKS=1 ;;
        u)      INSTUSER=$OPTARG ;;
        P)      USERPASSFILE=$OPTARG ;;
        A)      ADMIN=$OPTARG ;;
        e)      LUKS=1 ;;
        N)      NODHCP=1 ;;
        y)      YES=1 ;;
        *)      usage ;;
        esac
done

[ "$(id -u)" = 0 ] || die "must run as root"

case "$MODE" in
"")      # autodetect: UEFI when booted with efivars mounted
        if [ -d /sys/firmware/efi/efivars ]; then
                MODE=uefi
        else
                MODE=bios
        fi
        ;;
bios|uefi) ;;
*)       die "unknown bootloader mode: $MODE (bios|uefi)" ;;
esac

for t in sfdisk mkfs.ext4 blkid tar dd; do
        have "$t" || die "$t not found"
done
[ -f /usr/lib/kinini/initramfs-disk.img ] \
        || die "/usr/lib/kinini/initramfs-disk.img not found (live iso only)"
if [ "$LUKS" = 1 ]; then
        have cryptsetup || die "cryptsetup not found (add 'cryptsetup' to the live image)"
        [ "$MODE" = uefi ] || die "LUKS requires UEFI: extlinux cannot read an encrypted /boot"
        if [ -n "$PASSFILE" ]; then
                [ -f "$PASSFILE" ] || die "passphrase file not found: $PASSFILE"
        elif [ "$YES" = 1 ]; then
                die "-e with -y requires -p FILE (no console to ask for a passphrase)"
        fi
fi
if [ -n "$LOCALE" ]; then
        # strip every UTF-8 suffix and re-add exactly one: the old
        # ".utf8 -> .UTF-8" rewrite appended a second suffix to an
        # already-suffixed name ("ru_RU.UTF-8" became
        # "ru_RU.UTF-8.UTF-8"), which then rewrote the libc-locales
        # entry into a form the glibc-locales trigger ignores
        while :; do
                case "$LOCALE" in
                *.UTF-8)        LOCALE=${LOCALE%.UTF-8} ;;
                *.utf8)         LOCALE=${LOCALE%.utf8} ;;
                *)              break ;;
                esac
        done
        case "$LOCALE" in
        ""|*.*|*[!A-Za-z0-9_@]*) \
                        die "locale must be a language name like ru_RU or ru_RU.UTF-8" ;;
        esac
        LOCALE="$LOCALE.UTF-8"
fi
if [ -n "$ZONE" ] && [ ! -f "/usr/share/zoneinfo/$ZONE" ]; then
        die "unknown timezone: $ZONE (see /usr/share/zoneinfo)"
fi
if [ -n "$SCHED" ]; then
        case "$SCHED" in
        none)   : ;;
        scx*)   [ -x "/usr/bin/$SCHED" ] || die "$SCHED not found (add 'scx' to the live image)" ;;
        *)      die "scheduler must be one of the scx_* binaries or 'none'" ;;
        esac
fi

# ------------------------------------------------------------ desktop/user
detect_live_desktop() {
        # which graphical session does the running live system carry?
        if [ -x /usr/bin/startxfce4 ]; then
                echo xfce
        elif [ -x /usr/bin/labwc ]; then
                echo labwc
        else
                echo none
        fi
}
case "$DESKTOP" in
"")      ;;
auto)   DESKTOP=$(detect_live_desktop) ;;
xfce)   [ -x /usr/bin/startxfce4 ] \
                || die "xfce is not in the live image (add 'xfce4' to the live iso)" ;;
labwc)  [ -x /usr/bin/labwc ] \
                || die "labwc is not in the live image (add 'labwc' to the live iso)" ;;
none)   ;;
/dev/*|*[!a-z_]*) die "unknown desktop: '$DESKTOP' (since 0.5 the disk is -D DISK and -d picks the desktop: xfce|labwc|none)" ;;
*)      die "unknown desktop: $DESKTOP (xfce|labwc|none)" ;;
esac
case "$ADMIN" in
sudo|doas|both|"") ;;
*)      die "unknown admin tool: $ADMIN (sudo|doas|both)" ;;
esac
case "$INSTUSER" in
"")     ;;
[a-z_][a-z0-9_-]*) ;;
*)      die "invalid user name: $INSTUSER" ;;
esac
if [ -n "$USERPASSFILE" ]; then
        [ -f "$USERPASSFILE" ] || die "user password file not found: $USERPASSFILE"
        IFS= read -r USERPASS < "$USERPASSFILE" || true
        [ -n "$USERPASS" ] || die "empty user password in $USERPASSFILE"
fi
if [ -n "$INSTUSER" ] && [ "$YES" = 1 ] && [ -z "$USERPASS" ]; then
        die "-u with -y requires -P FILE (no console to ask for a password)"
fi

if [ "$MODE" = uefi ]; then
        MKFSVFAT=$(command -v mkfs.vfat || command -v mkfs.fat || true)
        [ -n "$MKFSVFAT" ] || die "mkfs.vfat not found (dosfstools)"
        [ -f /usr/lib/kinini/BOOTX64.EFI ] \
                || die "/usr/lib/kinini/BOOTX64.EFI not found (live iso only)"
else
        for t in extlinux mbr.bin ldlinux.c32; do
                case $t in
                extlinux)       sl=/usr/bin/extlinux ;;
                mbr.bin)        sl=/usr/lib/syslinux/mbr.bin ;;
                ldlinux.c32)    sl=/usr/lib/syslinux/ldlinux.c32 ;;
                esac
                [ -f "$sl" ] || die "$sl not found (syslinux package missing from the live image)"
        done
fi

# default swap: 2x RAM capped at 4 GiB, CachyOS-style zram handles the rest
RAM_MIB=$(awk '/^MemTotal:/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 512)
[ -n "$RAM_MIB" ] || RAM_MIB=512
if [ -z "$SWAP" ]; then
        SWAP=$(( RAM_MIB * 2 ))
        [ "$SWAP" -gt 4096 ] && SWAP=4096
fi
case "$SWAP" in
''|*[!0-9]*) die "swap size must be a non-negative integer (MiB)" ;;
esac

# ------------------------------------------------------------- pickers
pick_timezone() {
        ZD=/usr/share/zoneinfo
        REGIONS="Americas Asia Europe Africa Atlantic Australia Pacific"
        REG=Europe
        while :; do
                n=1
                echo "  timezone regions:"
                # shellcheck disable=SC2086
                for r in $REGIONS; do
                        printf '    %2d) %s\n' "$n" "$r"
                        n=$(( n + 1 ))
                done
                printf '  region [Europe]: '
                read -r ans
                REG=${ans:-Europe}
                [ -d "$ZD/$REG" ] && break
                echo "  no such region: $REG"
        done
        while :; do
                n=1
                echo "  timezones in $REG:"
                find "$ZD/$REG" -type f 2>/dev/null | sed "s|^$ZD/||" | sort | {
                        while read -r z; do
                                printf '    %2d) %s\n' "$n" "$z"
                                n=$(( n + 1 ))
                        done
                }
                printf '  timezone [1]: '
                read -r ans
                ans=${ans:-1}
                case "$ans" in
                *[!0-9]*)       ZONE=$ans ;;
                *)              ZONE=$(find "$ZD/$REG" -type f 2>/dev/null \
                                        | sed "s|^$ZD/||" | sort \
                                        | sed -n "${ans}p") ;;
                esac
                [ -n "$ZONE" ] && [ -f "$ZD/$ZONE" ] && return
                echo "  invalid choice: $ans"
        done
}

pick_locale() {
        # shellcheck disable=SC2086
        LOCS="en_US.UTF-8 ru_RU.UTF-8 de_DE.UTF-8 fr_FR.UTF-8 \
es_ES.UTF-8 it_IT.UTF-8 pl_PL.UTF-8 uk_UA.UTF-8"
        while :; do
                n=1
                echo "  locales (or type a full name, e.g. pt_BR.UTF-8):"
                # shellcheck disable=SC2086
                for l in $LOCS; do
                        printf '    %2d) %s\n' "$n" "$l"
                        n=$(( n + 1 ))
                done
                printf '  locale [1]: '
                read -r ans
                ans=${ans:-1}
                case "$ans" in
                *[!0-9]*)       LOCALE=$ans ;;
                *)              LOCALE=$(echo "$LOCS" | tr -s ' \n' '\n' \
                                        | sed -n "${ans}p") ;;
                esac
                # strip every UTF-8 suffix, re-add exactly one (see the
                # -l validation above); typing "de_DE" is fine too
                while :; do
                        case "$LOCALE" in
                        *.UTF-8)        LOCALE=${LOCALE%.UTF-8} ;;
                        *.utf8)         LOCALE=${LOCALE%.utf8} ;;
                        *)              break ;;
                        esac
                done
                case "$LOCALE" in
                ""|*.*|*[!A-Za-z0-9_@]*) \
                                echo "  invalid locale: $ans" ;;
                *)              LOCALE="$LOCALE.UTF-8"; return ;;
                esac
        done
}

pick_sched() {
        # list scx schedulers present in the live image (skip tools)
        SCXS=$(find /usr/bin -maxdepth 1 -name 'scx_*' 2>/dev/null \
                | sed 's|.*/||' \
                | grep -v -e '^scx_loader$' -e '^scxctl$' -e '^scx-' \
                | sort -u)
        [ -n "$SCXS" ] || { SCHED=none; return; }
        n=1
        echo "  sched_ext schedulers (CachyOS-style BPF CPU schedulers):"
        # shellcheck disable=SC2086
        for s in $SCXS; do
                printf '    %2d) %s\n' "$n" "$s"
                n=$(( n + 1 ))
        done
        echo "  scx_lavd is the CachyOS default (desktop and gaming)"
        printf '  scheduler [scx_lavd]: '
        read -r ans
        ans=${ans:-scx_lavd}
        case "$ans" in
        *[!0-9]*)       SCHED=$ans ;;
        *)              SCHED=$(echo "$SCXS" | sed -n "${ans}p") ;;
        esac
        [ "$SCHED" = none ] && return
        [ -x "/usr/bin/$SCHED" ] || SCHED=$(echo "$SCXS" | sed -n 1p)
}

read_luks_passphrase() {
        printf '  LUKS passphrase (hidden): '
        stty -echo 2>/dev/null || true
        read -r P1
        stty echo 2>/dev/null || true
        echo
        printf '  repeat passphrase: '
        stty -echo 2>/dev/null || true
        read -r P2
        stty echo 2>/dev/null || true
        echo
        [ -n "$P1" ] || die "empty passphrase"
        [ "$P1" = "$P2" ] || die "passphrases do not match"
        PASSFILE=$(mktemp /tmp/kiwi-luks.XXXXXX)
        chmod 600 "$PASSFILE"
        printf '%s' "$P1" > "$PASSFILE"
        TMPKEY=1
        P1=x P2=x
}

read_user_password() {
        printf '  password for %s (hidden): ' "$INSTUSER"
        stty -echo 2>/dev/null || true
        read -r P1
        stty echo 2>/dev/null || true
        echo
        printf '  repeat password: '
        stty -echo 2>/dev/null || true
        read -r P2
        stty echo 2>/dev/null || true
        echo
        [ -n "$P1" ] || die "empty password"
        [ "$P1" = "$P2" ] || die "passwords do not match"
        USERPASS=$P1
        P1=x P2=x
}

pick_desktop() {
        LIVE=$(detect_live_desktop)
        echo "  graphical session (the same one this live system uses by default):"
        if [ -x /usr/bin/startxfce4 ]; then
                printf '    1) xfce  - Xfce 4.20 + LightDM graphical login%s\n' \
                        "${LIVE:+$([ "$LIVE" = xfce ] && echo ' (as here)')}"
        fi
        if [ -x /usr/bin/labwc ]; then
                printf '    2) labwc - minimal Wayland session (login, run kinini-labwc)%s\n' \
                        "${LIVE:+$([ "$LIVE" = labwc ] && echo ' (as here)')}"
        fi
        echo "    3) none  - console only (packages stay installed)"
        printf '  desktop [%s]: ' "$LIVE"
        read -r ans
        ans=${ans:-1}
        case "$ans" in
        *[!0-9]*)       DESKTOP=$ans ;;
        1)              DESKTOP=xfce ;;
        2)              DESKTOP=labwc ;;
        3)              DESKTOP=none ;;
        *)              DESKTOP=$LIVE ;;
        esac
        case "$DESKTOP" in
        xfce|labwc|none) ;;
        *)      echo "  unknown desktop '$DESKTOP', using $LIVE"; DESKTOP=$LIVE ;;
        esac
}

pick_user() {
        printf '  create a regular user? [Y/n] '
        read -r ans
        case "$ans" in
        [Nn]*)  INSTUSER=; return ;;
        esac
        while :; do
                printf '  user name [kiwi]: '
                read -r ans
                INSTUSER=${ans:-kiwi}
                case "$INSTUSER" in
                [a-z_][a-z0-9_-]*) break ;;
                *)      echo "  invalid user name (lowercase letters, digits, _ -)" ;;
                esac
        done
        read_user_password
        printf '  privilege tool for %s (1) sudo, 2) doas, 3) both) [1]: ' \
                "$INSTUSER"
        read -r ans
        ans=${ans:-1}
        case "$ans" in
        2)      ADMIN=doas ;;
        3)      ADMIN=both ;;
        *)      ADMIN=sudo ;;
        esac
}

# ---------------------------------------------------------------- disk pick
if [ -z "$DISK" ]; then
        msg "available disks:"
        for d in /sys/block/*; do
                b=${d#/sys/block/}
                case "$b" in
                loop*|ram*|sr*|fd*|zram*|dm-*) continue ;;
                esac
                [ -f "$d/size" ] || continue
                [ -b "/dev/$b" ] || continue
                sz=$(( $(cat "$d/size") * 512 / 1024 / 1024 ))
                printf '  /dev/%-8s %5d MB\n' "$b" "$sz"
        done
        printf 'target disk: '
        read -r DISK
        [ -n "$DISK" ] || die "no disk given"
fi

case "$DISK" in
/dev/*) ;;
*)      DISK="/dev/$DISK" ;;
esac
[ -b "$DISK" ] || die "$DISK is not a block device"

partdev() {
        case "$DISK" in
        *nvme*|*mmcblk*)        echo "${DISK}p$1" ;;
        *)                      echo "$DISK$1" ;;
        esac
}

sz=$(( $(cat "/sys/block/${DISK#/dev/}/size") * 512 / 1024 / 1024 ))
if [ "$MODE" = uefi ]; then
        layout="GPT: ${ESP_MIB} MiB ESP + grub (UEFI)"
else
        layout="msdos: extlinux (BIOS)"
fi

# ------------------------------------------------------------- options
if [ "$YES" = 1 ]; then
        # non-interactive defaults
        if [ "$LUKS" = 1 ] && [ -z "$PASSFILE" ]; then
                die "-e with -y requires -p FILE (no console to ask for a passphrase)"
        fi
        [ -n "$ZONE" ] || ZONE=UTC
        [ -n "$LOCALE" ] || LOCALE=en_US.UTF-8
        if [ -z "$SCHED" ]; then
                if [ -x /usr/bin/scx_lavd ]; then
                        SCHED=scx_lavd
                else
                        SCHED=none
                fi
        fi
        if [ -z "$DESKTOP" ]; then
                DESKTOP=$(detect_live_desktop)
        fi
        # user: only from -u (password via -P, validated above); the
        # admin tool defaults to sudo
        [ -n "$ADMIN" ] || ADMIN=sudo
else
        if [ "$LUKS" = 0 ]; then
                if ask "encrypt root with LUKS2 (passphrase asked at boot)?" n; then
                        LUKS=1
                fi
        fi
        [ "$LUKS" = 0 ] || [ -n "$PASSFILE" ] || read_luks_passphrase
        [ -n "$ZONE" ] || pick_timezone
        [ -n "$LOCALE" ] || pick_locale
        if [ -z "$SCHED" ]; then
                if ask "enable a sched_ext CPU scheduler (CachyOS-style)?" y; then
                        pick_sched
                else
                        SCHED=none
                fi
        fi
        if [ -z "$DESKTOP" ]; then
                pick_desktop
        fi
        if [ -z "$INSTUSER" ]; then
                pick_user
        fi
fi

WIFIHW=0
for d in /sys/class/net/*; do
        if [ -e "$d/wireless" ]; then
                WIFIHW=1
                break
        fi
done

if [ "$YES" = 0 ]; then
        echo
        echo "  WARNING: everything on $DISK (${sz} MB) will be destroyed."
        echo "  Layout:  $layout, ext4 root"
        [ "$LUKS" = 0 ] || echo "  LUKS:    LUKS2 root (passphrase at boot)"
        if [ "$SWAP" -gt 0 ]; then
                if [ "$LUKS" = 1 ]; then
                        echo "  Swap:    ${SWAP} MiB, ephemeral random-key encryption" \
                                "(+ zram by default)"
                else
                        echo "  Swap:    ${SWAP} MiB partition (+ zram by default)"
                fi
        else
                echo "  Swap:    none (zram only)"
        fi
        echo "  Desktop: ${DESKTOP:-none}   User: ${INSTUSER:-none}   Admin: $ADMIN"
        echo "  Wifi:    $([ "$WIFIHW" = 1 ] && echo wpa_supplicant || echo 'no hardware')"
        echo "  Timezone: ${ZONE:-UTC}   Locale: ${LOCALE:-en_US.UTF-8}"
        echo "  SCX scheduler: ${SCHED:-none}"
        echo
        ask "proceed?" n || die "aborted"
fi

# ---------------------------------------------------------------- partition
msg "partitioning $DISK ($MODE)"
if [ "$MODE" = uefi ]; then
        {
                echo "label: gpt"
                echo "size=${ESP_MIB}MiB, type=U, name=KININI-ESP"
                if [ "$SWAP" -gt 0 ]; then
                        echo "size=${SWAP}MiB, type=S, name=KININI-SWAP"
                fi
                echo "type=L, name=KININI-ROOT"
        } | sfdisk -q "$DISK"
else
        {
                echo "label: dos"
                # swap first with an explicit size, root takes the rest
                # (an unsized partition consumes the whole disk)
                if [ "$SWAP" -gt 0 ]; then
                        echo "size=${SWAP}MiB, type=82"
                fi
                echo "type=83, bootable"
        } | sfdisk -q "$DISK"
fi

blockdev --rereadpt "$DISK" 2>/dev/null || true
sleep 1

if [ "$MODE" = uefi ]; then
        ESPPART=$(partdev 1)
        if [ "$SWAP" -gt 0 ]; then
                SWAPPART=$(partdev 2)
                ROOTPART=$(partdev 3)
        else
                SWAPPART=
                ROOTPART=$(partdev 2)
        fi
else
        if [ "$SWAP" -gt 0 ]; then
                SWAPPART=$(partdev 1)
                ROOTPART=$(partdev 2)
        else
                SWAPPART=
                ROOTPART=$(partdev 1)
        fi
fi

msg "creating filesystems"
if [ "$MODE" = uefi ]; then
        [ -b "$ESPPART" ] || die "partition $ESPPART did not appear"
        "$MKFSVFAT" -F 32 -n KININI-ESP "$ESPPART" >/dev/null
fi

ROOTFSDEV=$ROOTPART
if [ "$LUKS" = 1 ]; then
        msg "encrypting root: LUKS2 on $ROOTPART (mapper $LUKSNAME)"
        cryptsetup luksFormat --type luks2 --batch-mode \
                --key-file "$PASSFILE" "$ROOTPART"
        cryptsetup open --type luks --key-file "$PASSFILE" \
                "$ROOTPART" "$LUKSNAME"
        [ -b "/dev/mapper/$LUKSNAME" ] || die "/dev/mapper/$LUKSNAME did not appear"
        if [ "$TMPKEY" = 1 ]; then
                rm -f "$PASSFILE"
                PASSFILE=
                TMPKEY=0
        fi
        ROOTFSDEV="/dev/mapper/$LUKSNAME"
fi
# syslinux 6.03 cannot read fs with 64bit/metadata_csum/orphan_file,
# keep the feature set conservative for the bootloader
mkfs.ext4 -q -F -O ^64bit,^metadata_csum,^metadata_csum_seed,^orphan_file \
        -L kinini "$ROOTFSDEV"

if [ -n "$SWAPPART" ]; then
        [ -b "$SWAPPART" ] || die "partition $SWAPPART did not appear"
        if [ "$LUKS" = 1 ]; then
                # formatted with a fresh random key on every boot
                # (see the crypttab "swap" entry below)
                msg "swap will be encrypted with an ephemeral key (crypttab)"
        else
                mkswap -L kinini-swap "$SWAPPART" >/dev/null
                swapon "$SWAPPART" 2>/dev/null || true
                msg "swap on $SWAPPART (${SWAP} MiB)"
        fi
fi

# ---------------------------------------------------------------- copy root
mkdir -p "$TARGET"
mountpoint -q "$TARGET" && die "$TARGET already mounted"
mount -t ext4 "$ROOTFSDEV" "$TARGET"
if [ "$MODE" = uefi ]; then
        mkdir -p "$TARGET/boot/efi"
        mount -t vfat "$ESPPART" "$TARGET/boot/efi"
fi

msg "copying live system to $TARGET (this may take a while)"
tar -C / --one-file-system --numeric-owner -cf - . | tar -C "$TARGET" -xf -

# ------------------------------------------------------- un-live the target
msg "restoring standard gettys (no autologin)"
for t in 1 2 3 4 5 6; do
        f="$TARGET/etc/niinit/services/getty-tty$t/run"
        [ -f "$f" ] || continue
        sed -i -e 's/agetty -a root/agetty/' "$f"
done
sed -i -e 's/exec agetty -L tty1/exec agetty --noclear -L tty1/' \
        "$TARGET/etc/niinit/services/getty-tty1/run" 2>/dev/null || true
f="$TARGET/etc/niinit/services/getty-ttyS0/run"
[ -f "$f" ] && sed -i -e 's/agetty -a root/agetty/' "$f"

msg "removing live-only init tweaks"
sed -i '/^for f in \/var\/db\/xbps\/pkgdb-\*\.plist; do$/,/^exit 0$/d' \
        "$TARGET/etc/niinit/1"
grep -q '^exit 0$' "$TARGET/etc/niinit/1" || echo 'exit 0' \
        >> "$TARGET/etc/niinit/1"

msg "resetting live-only services and privileges"
# the tar copy brought every enabled live service along (dhcpcd, dbus,
# lightdm with autologin, seatd): reset them all and re-enable from the
# installer options below
for s in dhcpcd dbus lightdm seatd wpa_supplicant scx; do
        rm -rf "$TARGET/etc/niinit/services/$s"
done
# the live user's passwordless sudo never reaches the installed system
rm -f "$TARGET/etc/sudoers.d/kinini-live" 2>/dev/null || true
# strip the live autologin block from lightdm.conf
if [ -f "$TARGET/etc/lightdm/lightdm.conf" ]; then
        sed -i '/^autologin-/d' "$TARGET/etc/lightdm/lightdm.conf"
fi
# live-only Xorg noaccel tweak: real hardware wants accelerated glamor
rm -f "$TARGET/etc/X11/xorg.conf.d/10-kinini-live-noaccel.conf" 2>/dev/null || true

# ---------------------------------------------------------------- services
enable_service() {
        _s=$1
        [ -d "$TARGET/etc/niinit/services-available/$_s" ] || return 0
        ln -sfn "/etc/niinit/services-available/$_s" \
                "$TARGET/etc/niinit/services/$_s"
}

if [ "$NODHCP" = 0 ]; then
        msg "enabling DHCP client service (dhcpcd)"
        enable_service dhcpcd
fi

case "$DESKTOP" in
xfce)
        # no seatd here: xfce4 pulls in elogind, which serves the logind
        # API for LightDM/Xorg; two seat managers would fight over the seat
        msg "desktop: Xfce + LightDM graphical login (dbus, lightdm)"
        enable_service dbus
        enable_service lightdm
        ;;
labwc)
        msg "desktop: labwc (Wayland) - log in on a console and run 'kinini-labwc'"
        enable_service dbus
        enable_service seatd
        ;;
none | "")
        msg "desktop: none (console system; enable later with svctl)"
        ;;
esac

# wireless: enable wpa_supplicant when the machine has wifi hardware
# (kiwi-install runs in the live system, so the hardware is visible) and
# carry over the networks saved during the live session
if [ "$WIFIHW" = 1 ] \
        && [ -d "$TARGET/etc/niinit/services-available/wpa_supplicant" ]; then
        msg "wireless hardware detected: enabling wpa_supplicant"
        enable_service wpa_supplicant
        if [ -s /etc/wpa_supplicant/wpa_supplicant.conf ]; then
                mkdir -p "$TARGET/etc/wpa_supplicant"
                cp /etc/wpa_supplicant/wpa_supplicant.conf \
                        "$TARGET/etc/wpa_supplicant/wpa_supplicant.conf" \
                        2>/dev/null || true
        fi
fi

if [ "${SCHED:-none}" != none ] \
        && [ -d "$TARGET/etc/niinit/services-available/scx" ]; then
        if [ -x "$TARGET/usr/bin/$SCHED" ]; then
                msg "enabling sched_ext scheduler service ($SCHED)"
                printf '# written by kiwi-install\nSCX_SCHEDULER=%s\nSCX_FLAGS=\n' \
                        "$SCHED" > "$TARGET/etc/kinini/scx.conf"
                enable_service scx
        else
                msg "warning: $SCHED not found in the target, scx service skipped"
        fi
fi

# ---------------------------------------------------------------- timezone
if [ -n "$ZONE" ] && [ -f "/usr/share/zoneinfo/$ZONE" ]; then
        msg "setting timezone: $ZONE"
        ln -sfn "/usr/share/zoneinfo/$ZONE" "$TARGET/etc/localtime"
fi

# ---------------------------------------------------------------- locale
if [ -n "$LOCALE" ]; then
        msg "setting locale: $LOCALE"
        printf 'LANG=%s\n' "$LOCALE" > "$TARGET/etc/locale.conf"
        if [ -f "$TARGET/etc/default/libc-locales" ]; then
                # uncomment the matching line so glibc-locales generates
                # it. dots are escaped: the value must match the file
                # literally, not as a regex (a plain "ru_RU.UTF-8.UTF-8"
                # pattern would also eat the "ru_RU.UTF-8 UTF-8" line and
                # rewrite it into a form the glibc-locales trigger then
                # prints "Ignoring wrong locale" for)
                LOCRE=$(printf '%s' "$LOCALE" | sed 's/[.]/[.]/g')
                sed -i "s|^#${LOCRE} |${LOCALE} |" \
                        "$TARGET/etc/default/libc-locales"
                # belt and suspenders: the trigger needs "locale charset",
                # so append the entry if the uncomment above missed
                # (different file layout, older/newer glibc-locales, ...)
                grep -q "^${LOCALE} " \
                        "$TARGET/etc/default/libc-locales" || \
                        printf '%s UTF-8\n' "$LOCALE" \
                                >> "$TARGET/etc/default/libc-locales"
                msg "generating locale data (glibc-locales)"
                # xbps-reconfigure / locale-gen run the glibc-locales
                # scripts which need /proc, /dev (at least /dev/null)
                # and /sys. the tar copy skips live mountpoints
                # (--one-file-system) so the directories must exist
                # before the bind mounts
                mkdir -p "$TARGET/proc" "$TARGET/dev" "$TARGET/sys"
                mount -t proc proc "$TARGET/proc" 2>/dev/null || true
                mount -o bind /dev "$TARGET/dev" 2>/dev/null || true
                mount -t sysfs sys "$TARGET/sys" 2>/dev/null || true
                if [ -x "$TARGET/usr/sbin/locale-gen" ]; then
                        chroot "$TARGET" /usr/sbin/locale-gen \
                                > "$TARGET/var/log/locale-gen.log" 2>&1 \
                                || msg "warning: locale-gen failed" \
                                       "(${LOCALE} stays ungenerated; see" \
                                       "var/log/locale-gen.log)"
                else
                        chroot "$TARGET" /usr/bin/xbps-reconfigure \
                                -f glibc-locales \
                                > "$TARGET/var/log/locale-gen.log" 2>&1 \
                                || msg "warning: locale generation failed" \
                                       "(${LOCALE} stays ungenerated; see" \
                                       "var/log/locale-gen.log)"
                fi
                umount "$TARGET/sys" "$TARGET/dev" "$TARGET/proc" \
                        2>/dev/null || true
        fi
fi

# ---------------------------------------------------------------- fstab
UUID_ROOT=$(blkid -s UUID -o value "$ROOTFSDEV")
[ -n "$UUID_ROOT" ] || die "cannot read uuid of $ROOTFSDEV"
{
        if [ "$LUKS" = 1 ]; then
                echo "/dev/mapper/$LUKSNAME  /       ext4    defaults        0 1"
        else
                echo "UUID=$UUID_ROOT  /       ext4    defaults        0 1"
        fi
        echo "tmpfs       /tmp    tmpfs   defaults,nosuid 0 0"
        if [ "$MODE" = uefi ]; then
                UUID_ESP=$(blkid -s UUID -o value "$ESPPART")
                [ -n "$UUID_ESP" ] \
                        && echo "UUID=$UUID_ESP  /boot/efi  vfat  defaults  0 2"
        fi
        if [ -n "$SWAPPART" ]; then
                if [ "$LUKS" = 1 ]; then
                        echo "/dev/mapper/swap    none    swap    sw              0 0"
                else
                        UUID_SWAP=$(blkid -s UUID -o value "$SWAPPART")
                        [ -n "$UUID_SWAP" ] \
                                && echo "UUID=$UUID_SWAP  none    swap    sw              0 0"
                fi
        fi
} > "$TARGET/etc/fstab"

# ---------------------------------------------------------------- crypttab
if [ "$LUKS" = 1 ]; then
        LUKSUUID=$(blkid -s UUID -o value "$ROOTPART")
        [ -n "$LUKSUUID" ] || die "cannot read LUKS uuid of $ROOTPART"
        msg "writing /etc/crypttab"
        {
                echo "# unlocked by the initramfs (rd.luks.uuid= on the"
                echo "# kernel command line), passphrase asked at boot"
                echo "$LUKSNAME UUID=$LUKSUUID none luks,discard"
                if [ -n "$SWAPPART" ]; then
                        SWAPPTUUID=$(blkid -s PARTUUID -o value "$SWAPPART")
                        if [ -n "$SWAPPTUUID" ]; then
                                echo "# ephemeral encrypted swap: a fresh random"
                                echo "# key is drawn on every boot, no prompt"
                                echo "swap /dev/disk/by-partuuid/$SWAPPTUUID" \
                                        "/dev/urandom swap"
                        fi
                fi
        } > "$TARGET/etc/crypttab"
fi

# ---------------------------------------------------------------- password
if [ "$YES" = 0 ] && ask "set root password now?" y; then
        chroot "$TARGET" /usr/bin/passwd root
else
        msg "keeping default root password ($DEFROOTPW) - change it!"
fi

# ------------------------------------------------------- regular user
# the out-of-the-box user: in wheel (sudo/doas), video, audio and input,
# with a real login password - the live 'kiwi' NOPASSWD setup does not
# survive the installer (removed above)
if [ -n "$INSTUSER" ]; then
        msg "creating user: $INSTUSER (wheel, video, audio, input)"
        # the loop vars expand inside the chroot shell, not here
        # shellcheck disable=SC2016
        chroot "$TARGET" sh -c '
                for g in wheel video audio input; do
                        grep -q "^$g:" /etc/group || groupadd -r "$g"
                done
                id -u "'"$INSTUSER"'" >/dev/null 2>&1 \
                        || useradd -m -s /bin/bash \
                                -G wheel,video,audio,input "'"$INSTUSER"'"
        ' || die "could not create user $INSTUSER"
        printf '%s:%s\n' "$INSTUSER" "$USERPASS" \
                | chroot "$TARGET" chpasswd \
                || die "could not set the password for $INSTUSER"
        case "$ADMIN" in
        sudo | both)
                msg "admin tool: sudo (wheel in /etc/sudoers.d/wheel)"
                mkdir -p "$TARGET/etc/sudoers.d"
                printf '%%wheel ALL=(ALL:ALL) ALL\n' \
                        > "$TARGET/etc/sudoers.d/wheel"
                chmod 440 "$TARGET/etc/sudoers.d/wheel"
                if [ -f "$TARGET/etc/sudoers" ] \
                        && ! grep -q 'includedir /etc/sudoers.d' \
                                "$TARGET/etc/sudoers"; then
                        echo '@includedir /etc/sudoers.d' \
                                >> "$TARGET/etc/sudoers"
                fi
                ;;
        esac
        case "$ADMIN" in
        doas | both)
                msg "admin tool: doas (permit persist :wheel)"
                touch "$TARGET/etc/doas.conf"
                grep -q 'permit.*:wheel' "$TARGET/etc/doas.conf" \
                        || printf 'permit persist :wheel\n' \
                                >> "$TARGET/etc/doas.conf"
                chmod 644 "$TARGET/etc/doas.conf"
                ;;
        esac
else
        msg "no regular user (create one later: useradd -m -G wheel,video,audio,input <name>)"
fi

# ---------------------------------------------------------------- bootloader
# the disk kernel is the KiniNi kernel when its version file is present,
# otherwise the running live kernel (older isos)
KVER=$(uname -r)
if [ -f /usr/lib/kinini/kver ]; then
        KVER=$(cat /usr/lib/kinini/kver)
        msg "installing KiniNi kernel $KVER (sched_ext) and initramfs into the target"
        # the live kernel's module tree is useless for the KiniNi kernel
        # (everything is built in) and costs ~300 MB on the target disk
        if [ "$KVER" != "$(uname -r)" ] && [ -d "$TARGET/usr/lib/modules/$(uname -r)" ]; then
                msg "pruning live-kernel modules ($(uname -r)) from the target"
                rm -rf "$TARGET/usr/lib/modules/$(uname -r)"
        fi
else
        msg "installing kernel $KVER and initramfs into the target"
fi
cp /usr/lib/kinini/vmlinuz "$TARGET/boot/vmlinuz-$KVER"
chmod 644 "$TARGET/boot/vmlinuz-$KVER"
cp /usr/lib/kinini/initramfs-disk.img "$TARGET/boot/initramfs.img"

if [ "$LUKS" = 1 ]; then
        KCMD="root=/dev/mapper/$LUKSNAME rd.luks.uuid=$LUKSUUID rw earlyprintk=serial,ttyS0,115200 console=tty0 console=ttyS0,115200n8 loglevel=4"
else
        KCMD="root=UUID=$UUID_ROOT rw earlyprintk=serial,ttyS0,115200 console=tty0 console=ttyS0,115200n8 loglevel=4"
fi

if [ "$MODE" = uefi ]; then
        msg "writing grub configuration"
        mkdir -p "$TARGET/boot/grub"
        cat > "$TARGET/boot/grub/grub.cfg" <<EOF
set timeout=3
set default=0

menuentry "KiniNi Linux" {
    linux /boot/vmlinuz-$KVER $KCMD
    initrd /boot/initramfs.img
}
EOF
        # the standalone BOOTX64.EFI locates this filesystem by the
        # /.kinini-live marker and reads /boot/grub/grub.cfg from it
        : > "$TARGET/.kinini-live"

        # mirror the /boot layout onto the ESP and mark it: grub (no
        # cryptodisk) cannot read a LUKS root, so the early config's
        # marker search must be able to land on the ESP, where the
        # kernel, the initramfs and grub.cfg live. one passphrase
        # total - typed in the initramfs. on a plain install both the
        # root and the ESP carry the marker; either boots completely.
        msg "staging kernel + initramfs + grub.cfg on the ESP"
        mkdir -p "$TARGET/boot/efi/EFI/BOOT" "$TARGET/boot/efi/EFI/kinini" \
                "$TARGET/boot/efi/boot/grub"
        cp "$TARGET/boot/vmlinuz-$KVER" \
                "$TARGET/boot/efi/boot/vmlinuz-$KVER"
        cp "$TARGET/boot/initramfs.img" \
                "$TARGET/boot/efi/boot/initramfs.img"
        cat > "$TARGET/boot/efi/boot/grub/grub.cfg" <<EOF
set timeout=3
set default=0

menuentry "KiniNi Linux" {
    linux /boot/vmlinuz-$KVER $KCMD
    initrd /boot/initramfs.img
}
EOF
        : > "$TARGET/boot/efi/.kinini-live"

        msg "installing grub EFI loader on the ESP"
        install -m755 /usr/lib/kinini/BOOTX64.EFI \
                "$TARGET/boot/efi/EFI/BOOT/BOOTX64.EFI"
        install -m755 /usr/lib/kinini/BOOTX64.EFI \
                "$TARGET/boot/efi/EFI/kinini/grubx64.efi"
else
        msg "writing extlinux boot sector"
        mkdir -p "$TARGET/boot/extlinux"
        cat > "$TARGET/boot/extlinux/extlinux.conf" <<EOF
SERIAL 0 115200
DEFAULT kinini
PROMPT 0
TIMEOUT 30

LABEL kinini
        KERNEL /boot/vmlinuz-$KVER
        INITRD /boot/initramfs.img
        APPEND $KCMD
EOF

        /usr/bin/extlinux --install "$TARGET/boot/extlinux"
        install -m644 /usr/lib/syslinux/ldlinux.c32 "$TARGET/boot/extlinux/ldlinux.c32"
        dd if=/usr/lib/syslinux/mbr.bin of="$DISK" bs=440 count=1 \
                conv=notrunc status=none
fi

# ---------------------------------------------------------------- finish
msg "unmounting"
cd /
if [ "$MODE" = uefi ]; then
        umount "$TARGET/boot/efi"
fi
umount "$TARGET"
[ "$LUKS" = 1 ] && cryptsetup close "$LUKSNAME" 2>/dev/null || true
sync

echo
if [ "$LUKS" = 1 ]; then
        msg "done: KiniNi installed on $ROOTPART (LUKS2 UUID $LUKSUUID), root /dev/mapper/$LUKSNAME"
else
        msg "done: KiniNi installed on $ROOTPART (UUID $UUID_ROOT)"
fi
if [ "$MODE" = uefi ]; then
        msg "ESP: $ESPPART"
fi
msg "timezone: ${ZONE:-UTC}, locale: ${LOCALE:-en_US.UTF-8}, scx: ${SCHED:-none}"
msg "desktop: ${DESKTOP:-none}, user: ${INSTUSER:-none}, admin: $ADMIN," \
        "wifi: $([ "$WIFIHW" = 1 ] && echo wpa_supplicant || echo 'no hardware')"
if [ "${DESKTOP:-none}" = labwc ]; then
        msg "labwc: log in on a console, then run 'kinini-labwc'"
fi
msg "reboot and remove the live medium to boot from disk"
if [ "$LUKS" = 1 ]; then
        msg "the root passphrase will be asked once at every boot"
fi

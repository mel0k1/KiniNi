#!/bin/sh
# stage 1: mount the base filesystems and prepare the system for services
#
# the sequential part below is the critical path (nothing else can start
# without /proc, /sys, /dev and udevd). everything independent of it lives
# in /etc/niinit/1.d/ and runs in parallel afterwards via niinit-parallel:
# tasks there may declare prerequisites in <task>.deps files (see
# 60-crypttab.deps, 70-zram-swap.deps) - a task waits for its deps, a
# failed dep skips the dependents, boot never stops on a failed task.
mountpoint -q /proc  || mount -t proc proc /proc
mountpoint -q /sys   || mount -t sysfs sys /sys
mountpoint -q /dev   || mount -t devtmpfs dev /dev
mkdir -p /dev/pts /dev/shm /run /tmp
chmod 1777 /tmp
mountpoint -q /dev/pts || mount -t devpts devpts /dev/pts
mountpoint -q /dev/shm || mount -t tmpfs shm /dev/shm
mountpoint -q /run     || mount -t tmpfs run /run
[ -x /usr/bin/udevd ] && udevd --daemon
# independent stage-1 tasks in parallel (udev event replay, sysctl
# tuning, module loading, hugepage policy, pseudo-filesystems for BPF,
# loopback, encrypted swap, zram)
if [ -x /usr/bin/niinit-parallel ] && [ -d /etc/niinit/1.d ]; then
        niinit-parallel /etc/niinit/1.d \
                || echo "niinit: stage-1: some tasks failed (continuing)"
fi
# mount -a comes after the parallel block: fstab entries may need
# filesystem modules loaded there (vfat for the ESP on UEFI installs)
mount -a 2>/dev/null || true
swapon -a 2>/dev/null
[ -f /etc/hostname ] && hostname "$(cat /etc/hostname)" 2>/dev/null
[ -f /etc/random-seed ] && cat /etc/random-seed > /dev/urandom
exit 0

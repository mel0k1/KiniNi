# DHCP client service for wired interfaces, disabled by default.
# enable:   svctl enable dhcpcd && svctl start dhcpcd
# disable:  svctl stop dhcpcd && svctl disable dhcpcd
#
# Same invocation as the upstream void-runit service:
#   -B  --nobackground, stay in the foreground under the supervisor
#   -M  master mode, manage all interfaces
#   -q  quieter output
[ -x /usr/sbin/dhcpcd ] || {
        echo "dhcpcd: dhcpcd not installed" >&2
        exit 1
}
exec 2>&1
exec dhcpcd -B -M -q 1>&2

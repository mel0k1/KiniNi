#!/bin/sh
# sched_ext BPF CPU scheduler service (CachyOS-style), disabled by default.
# enable:   svctl enable scx && svctl start scx   (or: kinini-scx on)
# config:   /etc/kinini/scx.conf  (SCX_SCHEDULER, SCX_FLAGS)
# switch:   kinini-scx use scx_bpfland --now   (no reboot needed)
# status:   kinini-scx status / list / top
# sched:    kipki install scx     (schedulers: scx_lavd, scx_bpfland, ...)
#
# runs the scheduler in the foreground under the niinit supervisor,
# exactly like CachyOS' scx_loader would, minus the D-Bus dependency.
# output goes to /var/log/scx.log: schedulers are chatty at startup and
# a crash-looping one must not flood the console.
# shellcheck disable=SC1090,SC1091
[ -f /etc/kinini/scx.conf ] && . /etc/kinini/scx.conf
[ -x /usr/bin/modprobe ] && modprobe -q sched_ext 2>/dev/null
mountpoint -q /sys/fs/bpf 2>/dev/null || mount -t bpf bpf /sys/fs/bpf 2>/dev/null
SCX=${SCX_SCHEDULER:-scx_lavd}
[ -x "/usr/bin/$SCX" ] || {
        echo "scx: scheduler '$SCX' not found (kipki install scx)" >&2
        exit 1
}
echo "scx: loading sched_ext scheduler $SCX ${SCX_FLAGS}"
# shellcheck disable=SC2086
exec "$SCX" ${SCX_FLAGS} >> /var/log/scx.log 2>&1
